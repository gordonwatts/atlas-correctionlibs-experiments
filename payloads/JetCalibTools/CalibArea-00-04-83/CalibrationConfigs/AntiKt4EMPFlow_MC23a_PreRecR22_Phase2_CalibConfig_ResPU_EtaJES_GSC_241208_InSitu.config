######################
#
#  Settings for Release 22 Phase2 PFlow jet area + residual offset + absolute EtaJES + GSC correction
#
#  Config file author: Gediminas "G" Glemza
#                      06 March 2023 - updated by F. Balli Dec. 8th, 2024
#                      Pre-Rec for MC23 JES for general analysis team.
#
#####################

# --------------------------------------------------------------------------------------------------------------------------------------------------------------
# 0. Switch off detector eta setting for R21 (Comment from the past)
SetDetectorEta: false

# --------------------------------------------------------------------------------------------------------------------------------------------------------------
# 1. Absolute JES

  # The file with the absolute JES factors
AbsoluteJES.CalibFile:         JetCalibTools/CalibrationFactors/AntiKt4EMPFlow_MC23a_PreRecR22_Phase2_JES_constants.config
AbsoluteJES.CalibHists:        JetCalibTools/CalibrationFactors/AntiKt4EMPFlow_MC23a_PreRecR22_Phase2_JES_calibrationFactors.root
AbsoluteJES.Description:       MCJES derived in February 2024 for MC23a

  # How low in ET do we extrapolate along the calibration curve ?
AntiKt4EMPFlow.MinPtForETAJES:  15

  # Which method should be used to extend the calibration curve past the minimum ET ?
  # 0 = calibation curve is frozen at minimum ET
  # 1 = slope of calibration curve is frozen at minimum ET (recommended)
  # 2 = order 2 polynomial is used to extend the calibration curve
LowPtJESExtrapolationMethod:   1
LowPtJESExtrapolationMinimumResponse: 0.25

  # Parameters controling
AntiKt4EMPFlow.FreezeJEScorrectionatHighE: true
AntiKt4EMPFlow.isSpline: true

# --------------------------------------------------------------------------------------------------------------------------------------------------------------
# 2. Pile-up correction

  # New for rel 21 ( using OriginEventShape containers )
OriginCorrectedClusters: false

  # [PATCH] Specification to rho

RhoKey: Kt4EMPFlowNeutEventShape

  # What residual jet-area offset correction to apply
ResidualOffsetCorrection.Name:   ResidualOffsetMC23aFebruary2024

  # These corrections should correspond to the
  # conditions of the absolute JES calibration
OffsetCorrection.DefaultMuRef:   0
OffsetCorrection.DefaultNPVRef:  1

  # additional config files to include
ResidualOffset.CalibFile:      JetCalibTools/CalibrationFactors/AntiKt4EMPFlow_MC23a_PreRecR22_Phase2_ResidualPileUp_20240205.config

  # mu-scale factor used (only for MC)
MuScaleFactor:        1.00

  # should the beam-spot correction be applied (only for MC)
ApplyNPVBeamspotCorrection:     0

  # Set this to 1 to apply full 4-vector area correction
ApplyFullJetArea4MomentumCorrection:     0

  # Set this to 1 to turn off negative reco pT reset to 10 MeV during calibration
TurnOffNegativeReconstructedJetPtReset:   0

# --------------------------------------------------------------------------------------------------------------------------------------------------------------
# 3. Global sequential calibration

PTResponseRequirementOff: true # Response>1 requirement
nTrkwTrk4PFlow: true

GSCFactorsFile: JetCalibTools/CalibrationFactors/AntiKt4EMPFlow_MC23a_PreRecR22_Phase2_GSC_calibrationFactors_240306.root

# Order of GSC correction is chargedFraction->Tile0->EM3->nTrk->trackWIDTH->PunchThrough
# Use the GSCDepth flag to control the last correction applied
# Acceptable values for the GSC Depth flag are: "chargedFraction" (only for PFlow), "Tile0", "EM3", "nTrk", "trackWIDTH", "PunchThrough", or "Full" (equivalent to "PunchThrough")
GSCDepth: trackWIDTH
PunchThroughEtaBins: 0.0 1.3 1.9

# ----------------
# 5. Time-Dependent Insitu Calibration

TimeDependentInsituCalibration: true
InsituTimeDependentConfigs: InsituConfig_17_PF_Nov2018_Run3PreRec.config
InsituRunBins: 367384 999999

# ----------------
