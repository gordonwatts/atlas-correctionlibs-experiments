# 
#   Special components
#
##############################################################################

# Eta intercalibration combines 2D components with standard 1D components.
# Use explicit groups

# Eta intercalibration: theory uncertainty
JESGroup.1.Name:                    EtaIntercalibration_Modelling
JESGroup.1.Desc:                    Eta intercalibration: MC generator modelling uncertainty
JESGroup.1.Type:                    Modelling
JESGroup.1.Corr:                    Correlated
JESGroup.1.Group:                   1
JESGroup.1.Reducible:               False

JESComponent.99.Name:               EtaIntercalibration_Modelling_orig
JESComponent.99.Desc:               Eta intercalibration: MC generator modelling uncertainty
JESComponent.99.Type:               Modelling
JESComponent.99.Param:              PtEta
JESComponent.99.Hists:              EtaIntercalibration_Modelling
JESComponent.99.Group:              1
JESComponent.99.Reducible:          False

JESComponent.100.Name:              EtaIntercalibration_Modelling_prop
JESComponent.100.Desc:              Eta intercalibration: MC generator modelling uncertainty
JESComponent.100.Type:              Modelling
JESComponent.100.Param:             Pt
JESComponent.100.Hists:             InSituProp_EtaIntercalModelling
JESComponent.100.Group:             1
JESComponent.100.Reducible:         False

# Eta intercalibration: total statistical and method uncertainty
JESGroup.2.Name:                    EtaIntercalibration_TotalStat
JESGroup.2.Desc:                    Eta intercalibration: statistical uncertainty
JESGroup.2.Type:                    Statistical
JESGroup.2.Corr:                    Correlated
JESGroup.2.Group:                   2
JESGroup.2.Reducible:               False

JESComponent.101.Name:              EtaIntercalibration_TotalStat_orig
JESComponent.101.Desc:              Eta intercalibration: statistical uncertainty
JESComponent.101.Type:              Statistical
JESComponent.101.Param:             PtEta
JESComponent.101.Hists:             EtaIntercalibration_TotalStat
JESComponent.101.Group:             2
JESComponent.101.Reducible:         False

JESComponent.102.Name:              EtaIntercalibration_TotalStat_prop
JESComponent.102.Desc:              Eta intercalibration: statistical uncertainty
JESComponent.102.Type:              Statistical
JESComponent.102.Param:             Pt
JESComponent.102.Hists:             InSituProp_EtaIntercalStat
JESComponent.102.Group:             2
JESComponent.102.Reducible:         False

# High pT term
JESComponent.109.Name:              SingleParticle_HighPt
JESComponent.109.Desc:              High pT term (r20.7 version)
JESComponent.109.Type:              Detector
JESComponent.109.Param:             Pt
JESComponent.109.Reducible:         False

# Pileup needs to combine special 2D components with standard 1D components
# so it needs explicit groups.

# Mu term grouping
JESGroup.3.Name:                    Pileup_OffsetMu
JESGroup.3.Desc:                    Pileup: Offset, mu term
JESGroup.3.Type:                    Other
JESGroup.3.Corr:                    Correlated
JESGroup.3.Group:                   3
JESGroup.3.Reducible:               False

# Pileup: Original mu term
JESComponent.111.Name:               Pileup_OffsetMu_orig
JESComponent.111.Desc:               Pileup: Offset, mu term, independent
JESComponent.111.Type:               Other
JESComponent.111.Param:              PtEta
JESComponent.111.Special:            True
JESComponent.111.Hists:              Pileup_OffsetMu
JESComponent.111.Group:              3
JESComponent.111.Reducible:          False

# Pileup: Propagated mu term
JESComponent.112.Name:               Pileup_OffsetMu_prop
JESComponent.112.Desc:               Pileup: Offset, mu term, propagated through mjb
JESComponent.112.Type:               Other
JESComponent.112.Param:              Pt
JESComponent.112.Hists:              InSituProp_PileupOffsetMu
JESComponent.112.Group:              3
JESComponent.112.Reducible:          False

# NPV term grouping
JESGroup.4.Name:                    Pileup_OffsetNPV
JESGroup.4.Desc:                    Pileup: Offset, NPV term
JESGroup.4.Type:                    Other
JESGroup.4.Corr:                    Correlated
JESGroup.4.Group:                   4
JESGroup.4.Reducible:               False

# Pileup: Original NPV term
JESComponent.113.Name:               Pileup_OffsetNPV_orig
JESComponent.113.Desc:               Pileup: Offset, NPV term, independent
JESComponent.113.Type:               Other
JESComponent.113.Param:              PtEta
JESComponent.113.Special:            True
JESComponent.113.Hists:              Pileup_OffsetNPV
JESComponent.113.Group:              4
JESComponent.113.Reducible:          False

# Pileup: Propagated NPV term
JESComponent.114.Name:               Pileup_OffsetNPV_prop
JESComponent.114.Desc:               Pileup: Offset, NPV term, propagated through mjb
JESComponent.114.Type:               Other
JESComponent.114.Param:              Pt
JESComponent.114.Hists:              InSituProp_PileupOffsetNPV
JESComponent.114.Group:              4
JESComponent.114.Reducible:          False

# pT term grouping
JESGroup.5.Name:                    Pileup_PtTerm
JESGroup.5.Desc:                    Pileup: Offset, pT term
JESGroup.5.Type:                    Other
JESGroup.5.Corr:                    Correlated
JESGroup.5.Group:                   5
JESGroup.5.Reducible:               False

# Original pT term
JESComponent.115.Name:               Pileup_PtTerm_orig
JESComponent.115.Desc:               Pileup: Offset, pT term, independent
JESComponent.115.Type:               Other
JESComponent.115.Corr:               Correlated
JESComponent.115.Param:              PtEta
JESComponent.115.Special:            True
JESComponent.115.Hists:              Pileup_PtTerm_mu,Pileup_PtTerm_npv
JESComponent.115.Group:              5
JESComponent.115.Reducible:          False

# Propagated pT term
JESComponent.116.Name:               Pileup_PtTerm_prop
JESComponent.116.Desc:               Pileup: Offset, pT term, propagated through mjb
JESComponent.116.Type:               Other
JESComponent.116.Param:              Pt
JESComponent.116.Hists:              InSituProp_PileupPtTerm
JESComponent.116.Group:              5
JESComponent.116.Reducible:          False

# rho topology grouping
JESGroup.6.Name:                    Pileup_RhoTopology
JESGroup.6.Desc:                    Rho topology uncertainty (jet areas)
JESGroup.6.Type:                    Other
JESGroup.6.Corr:                    Correlated
JESGroup.6.Group:                   6
JESGroup.6.Reducible:               False

# Original JetAreas rho topology
JESComponent.117.Name:               Pileup_RhoTopology_orig
JESComponent.117.Desc:               Rho topology uncertainty (jet areas), independent
JESComponent.117.Type:               Other
JESComponent.117.Param:              PtEta
JESComponent.117.Special:            True
JESComponent.117.Hists:              Pileup_RhoTopology
JESComponent.117.Group:              6
JESComponent.117.Reducible:          False

# Propagated JetAreas rho topology
JESComponent.118.Name:               Pileup_RhoTopology_prop
JESComponent.118.Desc:               Rho topology uncertainty (jet areas), independent
JESComponent.118.Type:               Other
JESComponent.118.Param:              Pt
JESComponent.118.Hists:              InSituProp_PileupRhoTopology
JESComponent.118.Group:              6
JESComponent.118.Reducible:          False

# Flavour composition needs to combine special 2D components with standard 1D components
# so it needs explicit groups too.

# Flavour composition grouping
JESGroup.7.Name:                    Flavor_Composition
JESGroup.7.Desc:                    Flavor composition uncertainty
JESGroup.7.Type:                    Modelling
JESGroup.7.Corr:                    Correlated
JESGroup.7.Group:                   7
JESGroup.7.Reducible:               False

# Original flavour composition uncertainty
JESComponent.119.Name:               Flavor_Composition_orig
JESComponent.119.Desc:               Flavor composition uncertainty, independent
JESComponent.119.Type:               Modelling
JESComponent.119.Corr:               Correlated
JESComponent.119.Param:              PtEta
JESComponent.119.Special:            True
JESComponent.119.Hists:              flavorCompGlu,flavorCompLight
JESComponent.119.Group:              7
JESComponent.119.Reducible:          False

# Propagated flavour composition uncertainty
JESComponent.120.Name:               Flavor_Composition_prop
JESComponent.120.Desc:               Flavor composition uncertainty, propagated through mjb
JESComponent.120.Type:               Modelling
JESComponent.120.Param:              Pt
JESComponent.120.Hists:              InSituProp_FlavorComposition
JESComponent.120.Group:              7
JESComponent.120.Reducible:          False

# Flavour composition grouping
JESGroup.8.Name:                    Flavor_Response
JESGroup.8.Desc:                    Flavor response uncertainty (dominated by gluon response)
JESGroup.8.Type:                    Other
JESGroup.8.Corr:                    Correlated
JESGroup.8.Group:                   8
JESGroup.8.Reducible:               False

# Original flavour response uncertainty
JESComponent.121.Name:               Flavor_Response_orig
JESComponent.121.Desc:               Flavor response uncertainty, independent
JESComponent.121.Type:               Modelling
JESComponent.121.Param:              PtEta
JESComponent.121.Special:            True
JESComponent.121.Hists:              FlavorResponse
JESComponent.121.Group:              8
JESComponent.121.Reducible:          False

# Propagated flavour response uncertainty
JESComponent.122.Name:               Flavor_Response_prop
JESComponent.122.Desc:               Flavor response uncertainty, propagated through mjb
JESComponent.122.Type:               Modelling
JESComponent.122.Param:              Pt
JESComponent.122.Hists:              InSituProp_FlavorResponse
JESComponent.122.Group:              8
JESComponent.122.Reducible:          False

# bJES uncertainty
JESComponent.123.Name:               BJES_Response
JESComponent.123.Desc:               JES uncertainty for b jets
JESComponent.123.Type:               Modelling
JESComponent.123.Param:              PtEta
JESComponent.123.Special:            True
JESComponent.123.Hists:              bJES
JESComponent.123.Reducible:          False

