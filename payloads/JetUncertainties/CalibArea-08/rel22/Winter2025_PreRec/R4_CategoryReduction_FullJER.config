
##############################################################################
#
#  JESProvider Input Settings
#
#    JES Category reductions from Fall 2018 JES recommendations (R21).
#
#    Full JER treatment (MC and data smearing) from the Summer 2018 
#    recommendations iteration of the JER, with all NPs retained (R21).
#    
#    PerJet Flavour uncertainties
#
#    R22 Non closure uncertaintes wrt R21 (Absolute and Relative Insitu JES)
#    
#    May, 2023 - updating PreRec inputs
#    June, 2024 - Updating PreRec inputs - Jérémie
#    December 2024 - Add FCal component - Fabrice Balli 
#
#    K. Pachal (R21-JES), S. Schramm (R21-JER), C. Young (PerJet Flavour)
# 
##############################################################################

UncertaintyRelease:                 rel22_Winter2025_PreRec
SupportedJetDefs:                   AntiKt4EMPFlow
SupportedMCTypes:                   MC23
UncertaintyRootFile:                rel22/Winter2025_PreRec/R4_AllComponents.root
AnalysisRootFile:                   analysisInputs/UnknownFlavourComp.root

# <Mu> obtained from ATLAS public plots
# <NPV> from Eric's pileup studies
# Note that Eric's studies find a MuRef of 22.8 instead.
Pileup.MuRef:                       24.2
Pileup.NPVRef:                      13.2

